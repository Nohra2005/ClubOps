# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible provider (D-01). Examples:
#   OpenRouter (the course key, any model): CLUBOPS_BASE_URL=https://openrouter.ai/api/v1
#   Gemini: CLUBOPS_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OpenAI: CLUBOPS_BASE_URL=https://api.openai.com/v1
CLUBOPS_BASE_URL=
CLUBOPS_API_KEY=
CLUBOPS_MODEL=
# Prices in USD per million tokens, from the provider's price page (used for cost tracking).
CLUBOPS_PRICE_IN_PER_MTOK=0
CLUBOPS_PRICE_OUT_PER_MTOK=0
# replay (default, free, no network) | record (call and save answers) | live (call, save nothing)
CLUBOPS_MODEL_MODE=replay
# Recordings of real club data must point to a private folder outside the repo (D-04).
CLUBOPS_RECORDINGS_DIR=eval/recordings
# Per-plan limits (D-42)
CLUBOPS_BUDGET_USD_PER_PACKET=0.05
CLUBOPS_MAX_STEPS_PER_PLAN=8
CLUBOPS_TRACE_PATH=traces/clubops.jsonl
# Thinking models: low | medium | high; empty to not send it (F-161)
CLUBOPS_REASONING_EFFORT=low
# MLflow experiment tracking for evaluation runs (private, never committed)
CLUBOPS_TRACKING_DIR=data/private/mlflow

# --- Backend API (T-22) ---
CLUBOPS_DATA_DIR=data/app
# long random string; required unless CLUBOPS_DEV_LOGIN=1
CLUBOPS_SESSION_SECRET=
# Google sign-in client id (Google Cloud console, OAuth web client)
CLUBOPS_GOOGLE_CLIENT_ID=
# --- Google Calendar Integration ---
# Private JSON map of club slug to shared calendar ID (Google Calendar > Settings > Integrate calendar)
# Example shape only: {"running-club":"<private-id>","math-club":"<private-id>"}
CLUBOPS_GOOGLE_CALENDAR_IDS_JSON=
# Calendar key (T-46), separate from the Gmail key and from sign-in: OAuth client, scope calendar.events, refresh token.
# Private host settings only. In Testing mode Google cancels the refresh token every 7 days: renew it.
CLUBOPS_CALENDAR_CLIENT_ID=
CLUBOPS_CALENDAR_CLIENT_SECRET=
CLUBOPS_CALENDAR_REFRESH_TOKEN=
# 1 only on your own machine: allows POST /api/auth/dev {email}
CLUBOPS_DEV_LOGIN=0
# 0 only on your own machine (http://localhost)
CLUBOPS_COOKIE_SECURE=1

# ClubOps Gmail inbox (T-47): OAuth client "ClubOps inbox", scope gmail.readonly. Renew the refresh token every 7 days (Testing mode).
CLUBOPS_GMAIL_CLIENT_ID=
CLUBOPS_GMAIL_CLIENT_SECRET=
CLUBOPS_GMAIL_REFRESH_TOKEN=
# Connect the inbox inside the app (D-156): operators (comma-separated sign-in addresses) may connect or disconnect it.
# The redirect address must also be added to the "ClubOps inbox" client in Google Cloud. GMAIL_ADDRESS is optional.
CLUBOPS_OPERATOR_EMAILS=
CLUBOPS_GMAIL_REDIRECT_URI=
CLUBOPS_GMAIL_ADDRESS=
# Private lists the fetch needs on the host (never commit real ones): OSA staff senders, comma-separated
CLUBOPS_OSA_SENDERS=
# Extra forwarding addresses until J-22 verifies them: club:a@x,b@y;club2:c@z (private, never commit real ones)
CLUBOPS_INBOX_SENDERS=
# Optional debug log (off when empty). It can contain club text from model errors: point it under data/private/, never commit it
CLUBOPS_DEBUG_LOG=
