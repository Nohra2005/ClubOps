# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible provider (D-01). Examples:
#   Gemini: CLUBOPS_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OpenAI: CLUBOPS_BASE_URL=https://api.openai.com/v1
CLUBOPS_BASE_URL=
CLUBOPS_API_KEY=
CLUBOPS_MODEL=
# Prices in USD per million tokens, from the provider's price page (used for cost tracking).
CLUBOPS_PRICE_IN_PER_MTOK=0
CLUBOPS_PRICE_OUT_PER_MTOK=0
# replay (default, free, no network) | record (call and save answers) | live (call, save nothing)
CLUBOPS_MODEL_MODE=replay
# Recordings of real club data must point to a private folder outside the repo (D-04).
CLUBOPS_RECORDINGS_DIR=eval/recordings
# Per-plan limits (D-42)
CLUBOPS_BUDGET_USD_PER_PACKET=0.05
CLUBOPS_MAX_STEPS_PER_PLAN=8
CLUBOPS_TRACE_PATH=traces/clubops.jsonl
