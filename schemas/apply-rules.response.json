{
  "$comment": "clubops 0.2.1 \u00b7 capability apply-rules 0.1.1 \u00b7 generated",
  "$defs": {
    "Applicability": {
      "enum": [
        "applies",
        "not_applicable",
        "uncertain"
      ],
      "title": "Applicability",
      "type": "string"
    },
    "DerivedRequirement": {
      "additionalProperties": false,
      "properties": {
        "from_items": {
          "items": {
            "pattern": "^kh-[a-z0-9-]{2,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "From Items",
          "type": "array"
        },
        "requirement": {
          "$ref": "#/$defs/Requirement"
        },
        "uncertain": {
          "description": "True when only UNCERTAIN verdicts support it",
          "title": "Uncertain",
          "type": "boolean"
        }
      },
      "required": [
        "requirement",
        "from_items",
        "uncertain"
      ],
      "title": "DerivedRequirement",
      "type": "object"
    },
    "Error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "maxLength": 1000,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Error",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "invalid_input",
        "ambiguous_input",
        "not_found",
        "not_authorized",
        "stale_input",
        "conflict",
        "upstream_timeout",
        "upstream_error",
        "rate_limited",
        "malformed_model_output",
        "injection_suspected",
        "budget_exceeded",
        "internal"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "Issue": {
      "additionalProperties": false,
      "description": "A finding about the data (e.g. a time not in 24-hour format). Not a failure of the call.",
      "properties": {
        "code": {
          "pattern": "^[a-z_]+(\\.[a-z0-9_]+)+$",
          "title": "Code",
          "type": "string"
        },
        "fix": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fix"
        },
        "message": {
          "maxLength": 500,
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "description": "Something only a human can answer before the work can continue.",
      "properties": {
        "blocking": {
          "default": true,
          "title": "Blocking",
          "type": "boolean"
        },
        "choices": {
          "items": {
            "type": "string"
          },
          "title": "Choices",
          "type": "array"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "question_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
          "title": "Question Id",
          "type": "string"
        },
        "text": {
          "maxLength": 400,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "text"
      ],
      "title": "Question",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "kind": {
          "$ref": "#/$defs/RequirementKind"
        },
        "lead_time_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lead Time Days"
        },
        "name": {
          "maxLength": 200,
          "title": "Name",
          "type": "string"
        },
        "requirement_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "working_days": {
          "default": false,
          "description": "lead time counts working days only (no weekends or AUB holidays)",
          "title": "Working Days",
          "type": "boolean"
        }
      },
      "required": [
        "requirement_id",
        "kind",
        "name"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "RequirementKind": {
      "enum": [
        "form",
        "approval",
        "document",
        "lead_time",
        "restriction"
      ],
      "title": "RequirementKind",
      "type": "string"
    },
    "RuleApplication": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "pattern": "^ev-[a-z0-9-]{2,63}$",
          "title": "Event Id",
          "type": "string"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/DerivedRequirement"
          },
          "title": "Requirements",
          "type": "array"
        },
        "rulebook": {
          "description": "(item, version) of every rule considered",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "pattern": "^kh-[a-z0-9-]{2,63}$",
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Rulebook",
          "type": "array"
        },
        "spec_revision": {
          "minimum": 1,
          "title": "Spec Revision",
          "type": "integer"
        },
        "verdicts": {
          "items": {
            "$ref": "#/$defs/RuleVerdict"
          },
          "title": "Verdicts",
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "spec_revision",
        "rulebook",
        "verdicts",
        "requirements"
      ],
      "title": "RuleApplication",
      "type": "object"
    },
    "RuleVerdict": {
      "additionalProperties": false,
      "properties": {
        "facts_used": {
          "items": {
            "pattern": "^[a-z_][a-z0-9_.\\[\\]]*$",
            "type": "string"
          },
          "title": "Facts Used",
          "type": "array"
        },
        "item_id": {
          "pattern": "^kh-[a-z0-9-]{2,63}$",
          "title": "Item Id",
          "type": "string"
        },
        "item_version": {
          "minimum": 1,
          "title": "Item Version",
          "type": "integer"
        },
        "reason": {
          "maxLength": 400,
          "title": "Reason",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/Applicability"
        }
      },
      "required": [
        "item_id",
        "item_version",
        "verdict",
        "reason"
      ],
      "title": "RuleVerdict",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "error",
        "warning",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    },
    "Status": {
      "enum": [
        "ok",
        "needs_input",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "TraceMeta": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
          "title": "Capability",
          "type": "string"
        },
        "capability_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Capability Version",
          "type": "string"
        },
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Cost Usd"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "replayed": {
          "default": false,
          "title": "Replayed",
          "type": "boolean"
        },
        "retries": {
          "default": 0,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "tokens_in": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens In",
          "type": "integer"
        },
        "tokens_out": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens Out",
          "type": "integer"
        },
        "trace_id": {
          "maxLength": 64,
          "minLength": 8,
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "trace_id",
        "capability",
        "capability_version",
        "started_at",
        "latency_ms"
      ],
      "title": "TraceMeta",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuleApplication"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "degraded": {
      "default": false,
      "description": "True when a declared fallback produced the data",
      "title": "Degraded",
      "type": "boolean"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/Error"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Issues",
      "type": "array"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/Question"
      },
      "title": "Questions",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/Status"
    },
    "trace": {
      "$ref": "#/$defs/TraceMeta"
    }
  },
  "required": [
    "status",
    "trace"
  ],
  "title": "Result[RuleApplication]",
  "type": "object"
}
