{
  "$comment": "clubops 0.2.0 \u00b7 capability intake 0.1.0 \u00b7 generated",
  "$defs": {
    "Admission": {
      "enum": [
        "free_entry",
        "by_ticket",
        "not_applicable"
      ],
      "title": "Admission",
      "type": "string"
    },
    "AttendanceRange": {
      "additionalProperties": false,
      "properties": {
        "high": {
          "minimum": 1,
          "title": "High",
          "type": "integer"
        },
        "low": {
          "minimum": 1,
          "title": "Low",
          "type": "integer"
        }
      },
      "required": [
        "low",
        "high"
      ],
      "title": "AttendanceRange",
      "type": "object"
    },
    "Audience": {
      "enum": [
        "aub_students_only",
        "aub_and_non_aub_students"
      ],
      "title": "Audience",
      "type": "string"
    },
    "Error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "maxLength": 1000,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Error",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "invalid_input",
        "ambiguous_input",
        "not_found",
        "not_authorized",
        "stale_input",
        "conflict",
        "upstream_timeout",
        "upstream_error",
        "rate_limited",
        "malformed_model_output",
        "injection_suspected",
        "budget_exceeded",
        "internal"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "EventDraft": {
      "additionalProperties": false,
      "description": "Output of intake. Every non-empty field has a provenance entry.",
      "properties": {
        "provenance": {
          "patternProperties": {
            "^[a-z_][a-z0-9_.\\[\\]]*$": {
              "$ref": "#/$defs/FieldProvenance"
            }
          },
          "title": "Provenance",
          "type": "object"
        },
        "spec": {
          "$ref": "#/$defs/EventSpec"
        }
      },
      "required": [
        "spec",
        "provenance"
      ],
      "title": "EventDraft",
      "type": "object"
    },
    "EventSpec": {
      "additionalProperties": false,
      "properties": {
        "admission": {
          "anyOf": [
            {
              "$ref": "#/$defs/Admission"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "audience": {
          "anyOf": [
            {
              "$ref": "#/$defs/Audience"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "catering_items": {
          "items": {
            "type": "string"
          },
          "title": "Catering Items",
          "type": "array"
        },
        "club_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
          "title": "Club Id",
          "type": "string"
        },
        "collaborating_clubs": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
            "type": "string"
          },
          "title": "Collaborating Clubs",
          "type": "array"
        },
        "confirmed_by": {
          "anyOf": [
            {
              "pattern": "^m-[a-z0-9-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "set when a cabinet member confirms the spec",
          "title": "Confirmed By"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "estimated_budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "event_id": {
          "pattern": "^ev-[a-z0-9-]{2,63}$",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/EventType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "event_type_other": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Type Other"
        },
        "expected_attendance": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttendanceRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "funding": {
          "items": {
            "$ref": "#/$defs/Funding"
          },
          "title": "Funding",
          "type": "array"
        },
        "has_catering": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Has Catering"
        },
        "has_prizes": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Has Prizes"
        },
        "has_sales": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Has Sales"
        },
        "needs_materials": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Needs Materials"
        },
        "revision": {
          "description": "bumped on every change; downstream outputs record the revision they used",
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "sdgs": {
          "items": {
            "type": "integer"
          },
          "title": "Sdgs",
          "type": "array"
        },
        "speakers": {
          "items": {
            "$ref": "#/$defs/Speaker"
          },
          "title": "Speakers",
          "type": "array"
        },
        "start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "ticket_price": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 150,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "venue": {
          "anyOf": [
            {
              "$ref": "#/$defs/Venue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "event_id",
        "club_id",
        "revision"
      ],
      "title": "EventSpec",
      "type": "object"
    },
    "EventType": {
      "enum": [
        "conference",
        "community_service_event",
        "concert",
        "debate",
        "exhibition",
        "film_screening",
        "gala_dinner",
        "lecture",
        "meeting",
        "play",
        "reception",
        "sport",
        "trip",
        "workshop",
        "other"
      ],
      "title": "EventType",
      "type": "string"
    },
    "FieldProvenance": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "origin"
      ],
      "title": "FieldProvenance",
      "type": "object"
    },
    "Funding": {
      "enum": [
        "club_account",
        "external_sponsor",
        "faculty_department_aid",
        "usfc",
        "no_expenses"
      ],
      "title": "Funding",
      "type": "string"
    },
    "Issue": {
      "additionalProperties": false,
      "description": "A finding about the data (e.g. a time not in 24-hour format). Not a failure of the call.",
      "properties": {
        "code": {
          "pattern": "^[a-z_]+(\\.[a-z0-9_]+)+$",
          "title": "Code",
          "type": "string"
        },
        "fix": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fix"
        },
        "message": {
          "maxLength": 500,
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "default": "USD",
          "enum": [
            "USD",
            "LBP"
          ],
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount"
      ],
      "title": "Money",
      "type": "object"
    },
    "Origin": {
      "description": "Where a value came from. ``INFERRED`` values must be checked by a human.",
      "enum": [
        "stated",
        "retrieved",
        "computed",
        "inferred",
        "default"
      ],
      "title": "Origin",
      "type": "string"
    },
    "Question": {
      "additionalProperties": false,
      "description": "Something only a human can answer before the work can continue.",
      "properties": {
        "blocking": {
          "default": true,
          "title": "Blocking",
          "type": "boolean"
        },
        "choices": {
          "items": {
            "type": "string"
          },
          "title": "Choices",
          "type": "array"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "question_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
          "title": "Question Id",
          "type": "string"
        },
        "text": {
          "maxLength": 400,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "text"
      ],
      "title": "Question",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "error",
        "warning",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SourceKind": {
      "enum": [
        "chat_message",
        "email",
        "retrospective",
        "interview",
        "event_log",
        "form",
        "document",
        "user_input"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Points at the exact place a fact came from.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "locator": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "message id, line range, page",
          "title": "Locator"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "verbatim supporting text",
          "title": "Quote"
        },
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source_id",
        "observed_at"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "Speaker": {
      "additionalProperties": false,
      "properties": {
        "first_name": {
          "maxLength": 60,
          "title": "First Name",
          "type": "string"
        },
        "last_name": {
          "maxLength": 60,
          "title": "Last Name",
          "type": "string"
        },
        "nationality": {
          "maxLength": 60,
          "title": "Nationality",
          "type": "string"
        },
        "topic": {
          "maxLength": 200,
          "title": "Topic",
          "type": "string"
        }
      },
      "required": [
        "first_name",
        "last_name",
        "nationality",
        "topic"
      ],
      "title": "Speaker",
      "type": "object"
    },
    "Status": {
      "enum": [
        "ok",
        "needs_input",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "TraceMeta": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
          "title": "Capability",
          "type": "string"
        },
        "capability_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Capability Version",
          "type": "string"
        },
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Cost Usd"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "replayed": {
          "default": false,
          "title": "Replayed",
          "type": "boolean"
        },
        "retries": {
          "default": 0,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "tokens_in": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens In",
          "type": "integer"
        },
        "tokens_out": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens Out",
          "type": "integer"
        },
        "trace_id": {
          "maxLength": 64,
          "minLength": 8,
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "trace_id",
        "capability",
        "capability_version",
        "started_at",
        "latency_ms"
      ],
      "title": "TraceMeta",
      "type": "object"
    },
    "Venue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/VenueKind"
        },
        "name": {
          "maxLength": 120,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "Venue",
      "type": "object"
    },
    "VenueKind": {
      "enum": [
        "green_field",
        "west_hall",
        "classroom",
        "other_on_campus",
        "off_campus",
        "online"
      ],
      "title": "VenueKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/EventDraft"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "degraded": {
      "default": false,
      "description": "True when a declared fallback produced the data",
      "title": "Degraded",
      "type": "boolean"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/Error"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Issues",
      "type": "array"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/Question"
      },
      "title": "Questions",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/Status"
    },
    "trace": {
      "$ref": "#/$defs/TraceMeta"
    }
  },
  "required": [
    "status",
    "trace"
  ],
  "title": "Result[EventDraft]",
  "type": "object"
}
