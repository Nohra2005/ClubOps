{
  "$comment": "clubops 0.2.2 \u00b7 capability surface 0.1.0 \u00b7 generated",
  "$defs": {
    "Situation": {
      "additionalProperties": false,
      "description": "What the cabinet is about to do, used to surface relevant know-how.",
      "properties": {
        "event": {
          "anyOf": [
            {
              "pattern": "^ev-[a-z0-9-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event"
        },
        "on": {
          "format": "date",
          "title": "On",
          "type": "string"
        },
        "summary": {
          "maxLength": 500,
          "title": "Summary",
          "type": "string"
        },
        "tags": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "summary",
        "on"
      ],
      "title": "Situation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "club_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "title": "Club Id",
      "type": "string"
    },
    "limit": {
      "default": 8,
      "maximum": 30,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "situation": {
      "$ref": "#/$defs/Situation"
    }
  },
  "required": [
    "club_id",
    "situation"
  ],
  "title": "SurfaceRequest",
  "type": "object"
}
