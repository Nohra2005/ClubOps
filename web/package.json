{
  "name": "clubops-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:tools": "node --test scripts/project-*.test.mjs",
    "audit:dependencies": "npm audit --include=dev --audit-level=moderate",
    "board:plan": "node scripts/project-board.mjs",
    "board:sync": "node scripts/project-board.mjs --apply",
    "test:e2e": "playwright test",
    "test:e2e:http": "playwright test --config playwright.http.config.ts",
    "demo:check": "playwright test --config playwright.http.config.ts demo-rehearsal.spec.ts",
    "demo:record": "node scripts/demo-record.mjs",
    "typecheck:rehearsal": "tsc --project tsconfig.rehearsal.json --noEmit",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "test:e2e:compose": "playwright test --config playwright.compose.config.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test && npm run test:tools && npm run typecheck:rehearsal && npm run build",
    "board:reconcile:plan": "node scripts/project-native-board.mjs",
    "board:reconcile": "node scripts/project-native-board.mjs --apply --native-fields"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
